<div class="auth-card">
  <h2 class="text-center" style="margin-bottom: 2rem;">Create Account</h2>

  <%= form_with model: @user, url: registrations_path do |form| %>
    <% if @user.errors.any? %>
      <div class="alert alert-error">
        <p><%= pluralize(@user.errors.count, "error") %> prohibited this account from being created:</p>
        <ul style="margin-left: 1rem; margin-top: 0.5rem;">
          <% @user.errors.full_messages.each do |error| %>
            <li><%= error %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-group">
      <%= form.label :email_address %>
      <%= form.email_field :email_address, required: true, autofocus: true, placeholder: "you@example.com" %>
    </div>

    <div class="form-group">
      <%= form.label :password %>
      <%= form.password_field :password, required: true, placeholder: "••••••••" %>
    </div>

    <div class="form-group">
      <%= form.label :password_confirmation %>
      <%= form.password_field :password_confirmation, required: true, placeholder: "••••••••" %>
    </div>

    <%= form.submit "Create Account", class: "btn btn-primary" %>
  <% end %>

  <div class="mt-4 text-center text-sm" style="color: var(--text-secondary);">
    Already have an account? <%= link_to "Log in", new_session_path, class: "nav-link", style: "color: var(--primary)" %>
  </div>
</div>
