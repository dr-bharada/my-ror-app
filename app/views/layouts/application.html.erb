<!DOCTYPE html>
<html>
  <head>
    <title><%= portfolio_data["profile"]["name"] %> | <%= portfolio_data["profile"]["title"] %></title>
    <meta name="description" content="<%= portfolio_data["profile"]["summary"] %>">
    
    <!-- Open Graph / Social -->
    <meta property="og:type" content="website">
    <meta property="og:title" content="<%= portfolio_data["profile"]["name"] %> | <%= portfolio_data["profile"]["title"] %>">
    <meta property="og:description" content="<%= portfolio_data["profile"]["summary"] %>">
    <meta property="og:image" content="<%= portfolio_data["projects"][0]["image"] rescue '' %>">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= portfolio_data["profile"]["name"] %>">
    <meta name="twitter:description" content="<%= portfolio_data["profile"]["summary"] %>">
    
    <!-- SEO & Indexing -->
    <link rel="canonical" href="<%= request.original_url %>">
    <meta name="robots" content="index, follow">
    <meta name="keywords" content="<%= portfolio_data["skills"].flat_map { |s| s["items"] }.join(", ") %>">

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "<%= portfolio_data["profile"]["name"] %>",
        "jobTitle": "<%= portfolio_data["profile"]["title"] %>",
        "description": "<%= portfolio_data["profile"]["summary"] %>",
        "url": "<%= request.original_url %>",
        "sameAs": [
          "<%= portfolio_data["profile"]["linkedin"] %>",
          "<%= portfolio_data["profile"]["github"] %>"
        ],
        "email": "mailto:<%= portfolio_data["profile"]["email"] %>",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "<%= portfolio_data["profile"]["location"] %>"
        }
      }
    </script>

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

    <%# Include stylesheet %>
    <%= stylesheet_link_tag :application, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header>
      <div class="container">
        <nav>
          <%= link_to root_path, class: "brand" do %>
            <img src="/icon.svg" alt="DB" style="height: 32px; width: 32px; margin-right: 0.75rem;">
            <span>DAYA B</span><span class="dot">.</span>
          <% end %>
          <div class="nav-links">
            <%= link_to "Home", root_path, class: "nav-link" %>
            <%= link_to "Experience", root_path(anchor: "experience"), class: "nav-link" %>
            <%= link_to "Projects", root_path(anchor: "projects"), class: "nav-link" %>
            <%= link_to "Blog", blog_path, class: "nav-link" %>
          </div>
        </nav>
      </div>
    </header>

    <main class="container">
      <% if flash[:alert] %>
        <div class="alert alert-error mt-4">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <% if flash[:notice] %>
        <div class="alert alert-success mt-4">
          <%= flash[:notice] %>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <footer style="text-align: center; padding: 2rem 0; color: var(--text-secondary); font-size: 0.9rem; border-top: 1px solid var(--glass-border); margin-top: 4rem;">
      <div class="container">
        <p>&copy; <%= Time.current.year %> <%= portfolio_data["profile"]["name"] %>. All rights reserved.</p>
        <p style="opacity: 0.6; margin-top: 0.5rem; font-size: 0.8rem;">
          Built with <span style="color: #CC0000; font-weight: 600;">Ruby on Rails</span> & <span style="color: var(--primary);">Stimulus</span>
        </p>
      </div>
    </footer>
  </body>
</html>
