<div class="glass project-card glass-hover">
  <% if project["image"] %>
    <div class="project-image-container" style="margin: -2.5rem -2.5rem 1.5rem -2.5rem; height: 200px; overflow: hidden; border-bottom: 1px solid var(--glass-border);">
      <img src="<%= project["image"] %>" alt="<%= project["title"] %>" style="width: 100%; height: 100%; object-fit: cover;">
    </div>
  <% end %>
  <h3><%= project["title"] %></h3>
  <p><%= project["description"] %></p>
  <div class="project-tags">
    <% project["tags"].each do |tag| %>
      <span class="project-tag"><%= tag %></span>
    <% end %>
  </div>
</div>
